<script>
function silmeOnayi(bolumId) {
    document.getElementById("silBolumId").value = bolumId;
    document.getElementById("silmeModal").classList.add("aktif");
}

function modalKapat() {
    document.getElementById("silmeModal").classList.remove("aktif");
}
</script>

