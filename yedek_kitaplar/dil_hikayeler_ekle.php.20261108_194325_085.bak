
<?php
session_start();

require_once __DIR__ . "/../config/baglanti.php";

// Giriş kontrolü
if (!isset($_SESSION["kullanici_id"])) {
    header("Location: ../kullanici/giris.php");
    exit;
}

$hata = "";
$basarili = isset($_GET["basarili"]);

$kategoriSorgu = $db->query("
    SELECT id, kategori_adi
    FROM kategoriler
    ORDER BY kategori_adi ASC
");
$kategoriler = $kategoriSorgu->fetchAll();

// CSRF token
if (empty($_SESSION["csrf_token"])) {
    $_SESSION["csrf_token"] = bin2hex(random_bytes(32));
}

if ($_SERVER["REQUEST_METHOD"] === "POST") {

    if (
        !isset($_POST["csrf_token"]) ||
        !hash_equals($_SESSION["csrf_token"], $_POST["csrf_token"])
    ) {
        $hata = "Güvenlik doğrulaması başarısız.";
    } else {

        $baslik = trim($_POST["baslik"] ?? "");
        $aciklama = trim($_POST["aciklama"] ?? "");
        $kategori_id = !empty($_POST["kategori_id"])
            ? (int)$_POST["kategori_id"]
            : null;

        if ($baslik === "" || $aciklama === "") {
            $hata = "Lütfen başlık ve açıklama alanlarını doldurun.";
        } elseif (mb_strlen($baslik) > 150) {
            $hata = "Hikâye başlığı en fazla 150 karakter olabilir.";
        } else {

            // Kategori kontrolü
            if ($kategori_id !== null) {
                $kontrol = $db->prepare(
                    "SELECT id FROM kategoriler WHERE id = ?"
                );
                $kontrol->execute([$kategori_id]);

                if (!$kontrol->fetch()) {
                    $hata = "Geçersiz kategori seçimi.";
                }
            }

            $kapakYolu = null;

            // Kapak fotoğrafı yükleme
            if (
                empty($hata) &&
                isset($_FILES["kapak_resmi"]) &&
                $_FILES["kapak_resmi"]["error"] !== UPLOAD_ERR_NO_FILE
            ) {

                if ($_FILES["kapak_resmi"]["error"] !== UPLOAD_ERR_OK) {
                    $hata = "Fotoğraf yüklenirken bir hata oluştu.";
                } elseif ($_FILES["kapak_resmi"]["size"] > 3 * 1024 * 1024) {
                    $hata = "Kapak fotoğrafı en fazla 3 MB olabilir.";
                } else {

                    $geciciDosya = $_FILES["kapak_resmi"]["tmp_name"];
                    $resimBilgisi = @getimagesize($geciciDosya);

                    $izinliTurler = [
                        "image/jpeg" => "jpg",
                        "image/png" => "png",
                        "image/webp" => "webp"
                    ];

                    if (
                        $resimBilgisi === false ||
                        !isset($izinliTurler[$resimBilgisi["mime"]])
                    ) {
                        $hata = "Sadece JPG, PNG veya WEBP fotoğraf yükleyebilirsiniz.";
                    } else {

                        $klasor = __DIR__ . "/../uploads/kapaklar/";

                        if (
                            !is_dir($klasor) &&
                            !mkdir($klasor, 0755, true)
                        ) {
                            $hata = "Fotoğraf klasörü oluşturulamadı.";
                        } else {

                            $dosyaAdi = bin2hex(random_bytes(16))
                                . "." . $izinliTurler[$resimBilgisi["mime"]];

                            if (
                                move_uploaded_file(
                                    $geciciDosya,
                                    $klasor . $dosyaAdi
                                )
                            ) {
                                $kapakYolu = "uploads/kapaklar/" . $dosyaAdi;
                            } else {
                                $hata = "Fotoğraf kaydedilemedi.";
                            }
                        }
                    }
                }
            }

            // Hikâyeyi veritabanına kaydet
            if (empty($hata)) {

                try {
                    $ekle = $db->prepare("
                        INSERT INTO hikayeler
                        (
                            kullanici_id,
                            kategori_id,
                            baslik,
                            aciklama,
                            kapak_resmi,
                            durum
                        )
                        VALUES (?, ?, ?, ?, ?, 'taslak')
                    ");

                    $ekle->execute([
                        $_SESSION["kullanici_id"],
                        $kategori_id,
                        $baslik,
                        $aciklama,
                        $kapakYolu
                    ]);

                    header("Location: ekle.php?basarili=1");
                    exit;

                } catch (PDOException $e) {
                    if ($kapakYolu !== null) {
                        @unlink(__DIR__ . "/../" . $kapakYolu);
                    }

                    $hata = "Hikâye kaydedilirken bir hata oluştu.";
                }
            }
        }
    }
}
?>

