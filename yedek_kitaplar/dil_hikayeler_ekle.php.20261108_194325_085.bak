<div class="form-sayfa">

    <div class="form-kutu">

        <h1 class="form-baslik">📖 Yeni Hikâye Oluştur</h1>

        <p class="form-aciklama">
            Hayalindeki hikâyeyi oluştur ve WordNest okuyucularıyla paylaşmaya hazırlan.
        </p>

        <?php if ($basarili): ?>
            <div class="basarili">
                Hikâyen taslak olarak kaydedildi!
                Şimdi yeni bir hikâye oluşturabilir veya devam edebilirsin.
            </div>
        <?php endif; ?>

        <?php if ($hata !== ""): ?>
            <div class="hata">
                <?= htmlspecialchars($hata, ENT_QUOTES, "UTF-8") ?>
            </div>
        <?php endif; ?>

        <form method="POST" enctype="multipart/form-data">

            <input
                type="hidden"
                name="csrf_token"
                value="<?= htmlspecialchars($_SESSION["csrf_token"]) ?>"
            >

            <div class="alan">
                <label>Hikâye Başlığı *</label>
                <input
                    type="text"
                    name="baslik"
                    maxlength="150"
                    placeholder="Hikâyenin adını yaz..."
                    value="<?= htmlspecialchars($_POST["baslik"] ?? "", ENT_QUOTES, "UTF-8") ?>"
                    required
                >
            </div>

            <div class="alan">
                <label>Hikâye Açıklaması *</label>
                <textarea
                    name="aciklama"
                    placeholder="Hikâyenin konusunu kısaca anlat..."
                    required
                ><?= htmlspecialchars($_POST["aciklama"] ?? "", ENT_QUOTES, "UTF-8") ?></textarea>
            </div>

            <div class="alan">
                <label>Kategori</label>

                <select name="kategori_id">
                    <option value="">Kategori seçin</option>

                    <?php foreach ($kategoriler as $kategori): ?>
                        <option
                            value="<?= (int)$kategori["id"] ?>"
                            <?= (($_POST["kategori_id"] ?? "") == $kategori["id"]) ? "selected" : "" ?>
                        >
                            <?= htmlspecialchars($kategori["kategori_adi"], ENT_QUOTES, "UTF-8") ?>
                        </option>
                    <?php endforeach; ?>

                </select>
            </div>

            <div class="alan">
                <label>Kapak Fotoğrafı</label>

                <input
                    type="file"
                    name="kapak_resmi"
                    accept=".jpg,.jpeg,.png,.webp"
                >

                <span class="yardim">
                    JPG, PNG veya WEBP formatında, en fazla 3 MB.
                </span>
            </div>

            <button type="submit" class="form-btn">
                Hikâyemi Kaydet
            </button>

        </form>

    </div>

</div>

