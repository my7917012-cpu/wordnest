<?php
require_once __DIR__ . "/config/baglanti.php";
$id = filter_input(INPUT_GET, "id", FILTER_VALIDATE_INT);
if (!$id) {
    http_response_code(404);
    exit("Kitap bulunamadı.");
}
$sorgu = $db->prepare("SELECT k.id, k.baslik, k.yazar, k.uzanti, k.dosya_adi, k.icerik, c.kategori_adi FROM kitap_dosyalari k JOIN kategoriler c ON c.id = k.kategori_id WHERE k.id = ?");
$sorgu->execute([$id]);
$kitap = $sorgu->fetch();
if (!$kitap) {
    http_response_code(404);
    exit("Kitap bulunamadı.");
}
$dosyaYolu = __DIR__ . "/uploads/kitaplar/" . basename($kitap["dosya_adi"]);
if (!is_file($dosyaYolu)) {
    http_response_code(404);
    exit("Kitap dosyası bulunamadı.");
}

$metin = trim((string) ($kitap["icerik"] ?? ""));
if ($metin === "") {
    if ($kitap["uzanti"] === "pdf") {
        $autoload = __DIR__ . "/vendor/autoload.php";
        if (is_file($autoload)) {
            require_once $autoload;
            try {
                $ayar = new \Smalot\PdfParser\Config();
                $ayar->setDecodeMemoryLimit(64 * 1024 * 1024);
                $parser = new \Smalot\PdfParser\Parser([], $ayar);
                $metin = trim($parser->parseFile($dosyaYolu)->getText());
            } catch (Throwable $e) {
                $metin = "";
            }
        }
    } else {
        $metin = trim((string) file_get_contents($dosyaYolu));
        if (!mb_check_encoding($metin, "UTF-8")) {
            $metin = mb_convert_encoding($metin, "UTF-8", "Windows-1254");
        }
    }
    if ($metin !== "") {
        $guncelle = $db->prepare("UPDATE kitap_dosyalari SET icerik = ? WHERE id = ?");
        $guncelle->execute([$metin, $id]);
    }
}
?>
