    <div class="kitap-kimlik"><h1><?= htmlspecialchars($kitap["baslik"], ENT_QUOTES, "UTF-8") ?></h1><p>📖 Kategori: <?= htmlspecialchars($kitap["kategori_adi"], ENT_QUOTES, "UTF-8") ?></p></div>
    <article class="kitap-okuma-karti">
        <p class="kitap-etiket">WORDNEST KİTAP OKUMA SAYFASI</p>
        <h2 class="kitap-baslik"><?= htmlspecialchars($kitap["baslik"], ENT_QUOTES, "UTF-8") ?></h2>
        <p class="kitap-yazar">✍️ Yazar: <?= htmlspecialchars($kitap["yazar"] ?: "Belirtilmedi", ENT_QUOTES, "UTF-8") ?></p>
        <div class="kitap-ayrac"></div>
        <?php if ($metin !== ""): ?><div class="kitap-metin"><?= htmlspecialchars($metin, ENT_QUOTES | ENT_SUBSTITUTE, "UTF-8") ?></div><?php else: ?><div class="kitap-hata">Bu PDF'den yazı çıkarılamadı. Taranmış/görüntü PDF'leri metin olarak açılamıyor; metin içeren bir PDF ya da TXT sürümü yükle.</div><?php endif; ?>
    </article>
    <div class="kitap-alt-islemler"><a class="geri" href="kitaplar.php">← Kitaplığa dön</a><a href="kitap_dosya.php?id=<?= (int) $kitap["id"] ?>&indir=1">Kitap dosyasını indir</a></div>
    <p class="kitap-alt">❤️ WordNest'te keyifli okumalar!</p>
</main>
