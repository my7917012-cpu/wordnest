<?php
session_start();
require_once __DIR__ . "/config/baglanti.php";
$girisYapildi = isset($_SESSION["kullanici_id"]);
$adminMi = $girisYapildi && ($_SESSION["rol"] ?? "") === "admin";
$sorgu = $db->query("SELECT k.id, k.baslik, k.yazar, k.uzanti, c.kategori_adi FROM kitap_dosyalari k JOIN kategoriler c ON c.id = k.kategori_id ORDER BY c.kategori_adi, k.baslik");
$kitaplar = $sorgu->fetchAll();
$gruplar = [];
foreach ($kitaplar as $kitap) {
    $gruplar[$kitap["kategori_adi"]][] = $kitap;
}
?>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitaplar - WordNest</title><link rel="stylesheet" href="assets/css/style.css">
    <style>
        body{background:#fffaf5}.kitap-sayfa{max-width:1200px;margin:45px auto;padding:0 24px 65px}.kitap-sayfa h1{font-size:34px;margin-bottom:8px}.kitap-aciklama{color:#777;margin:0 0 32px}.kitap-grup{margin:32px 0}.kitap-grup h2{font-size:23px;color:#333;border-bottom:2px solid #ffe1cc;padding-bottom:10px}.kitap-izgara{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin-top:18px}.kitap-ogesi{background:white;border:1px solid #f1e3d8;border-radius:14px;padding:20px;box-shadow:0 5px 18px rgba(0,0,0,.045);min-height:190px;display:flex;flex-direction:column}.kitap-resim{height:76px;width:58px;border-radius:7px;background:linear-gradient(145deg,#f07824,#ffbd83);color:white;display:grid;place-items:center;font-size:29px;margin-bottom:13px}.kitap-ogesi h3{font-size:18px;line-height:1.35;margin:0 0 5px}.kitap-ogesi p{color:#777;margin:0 0 15px}.kitap-ogesi a{margin-top:auto;color:#e85d00;font-weight:bold}.kitap-bos{background:white;border:1px solid #f1e3d8;border-radius:12px;padding:24px;color:#777}.kitap-admin-link{display:inline-block;background:#f07824;color:white!important;padding:10px 15px;border-radius:8px;margin:0 0 14px}
    </style>
</head>
<body>
<header class="ust-menu"><div class="container menu-icerik"><a href="index.php" class="logo"><span>Word</span>Nest</a><nav class="ana-menu"><a href="index.php">Ana Sayfa</a><a href="hikayeler/liste.php">Hikâyeler</a><a href="kitaplar.php" class="aktif">Kitaplar</a></nav><div class="menu-butonlar"><?php if ($adminMi): ?><a class="giris-buton" href="admin/kitap_ekle.php">Kitap Yönetimi</a><?php elseif ($girisYapildi): ?><a class="giris-buton" href="kullanici/cikis.php">Çıkış Yap</a><?php else: ?><a class="giris-buton" href="kullanici/giris.php">Giriş Yap</a><a class="kayit-buton" href="kullanici/kayit.php">Üye Ol</a><?php endif; ?></div></div></header>
<main class="kitap-sayfa">
    <h1>WordNest Kitaplığı</h1>
    <p class="kitap-aciklama">WordNest'e eklenmiş kitapları kategorilerine göre keşfet ve uygulama içinde oku.</p>
    <?php if ($adminMi): ?><a class="kitap-admin-link" href="admin/kitap_ekle.php">+ Kitap ekle veya yönet</a><?php endif; ?>
    <?php if (!$kitaplar): ?><div class="kitap-bos">Henüz kitap eklenmemiş. Yönetici, uygun kitap dosyalarını admin panelinden ekleyebilir.</div><?php endif; ?>
    <?php foreach ($gruplar as $kategoriAdi => $liste): ?><section class="kitap-grup"><h2><?= htmlspecialchars($kategoriAdi, ENT_QUOTES, "UTF-8") ?></h2><div class="kitap-izgara"><?php foreach ($liste as $kitap): ?><article class="kitap-ogesi"><div class="kitap-resim" aria-hidden="true">📖</div><h3><?= htmlspecialchars($kitap["baslik"], ENT_QUOTES, "UTF-8") ?></h3><p><?= htmlspecialchars($kitap["yazar"] ?: "Yazar belirtilmedi", ENT_QUOTES, "UTF-8") ?></p><a href="kitap_oku.php?id=<?= (int) $kitap["id"] ?>">WordNest'te oku →</a></article><?php endforeach; ?></div></section><?php endforeach; ?>
</main>
</body>
</html>
