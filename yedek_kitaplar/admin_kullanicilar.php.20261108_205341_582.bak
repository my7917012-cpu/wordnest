    <div class="table-container">

        <?php if ($toplamKullanici > 0): ?>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ad Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>E-posta</th>
                        <th>Rol</th>
                        <th>Kayıt Tarihi</th>
                        <th>İşlem</th>
                    </tr>
                </thead>

                <tbody>

                    <?php foreach ($kullanicilar as $kullanici): ?>

                        <tr>
                            <td><?= (int)$kullanici["id"] ?></td>

                            <td>
                                <?= htmlspecialchars($kullanici["ad_soyad"] ?? "", ENT_QUOTES, "UTF-8") ?>
                            </td>

                            <td>
                                <?= htmlspecialchars($kullanici["kullanici_adi"], ENT_QUOTES, "UTF-8") ?>
                            </td>

                            <td>
                                <?= htmlspecialchars($kullanici["email"], ENT_QUOTES, "UTF-8") ?>
                            </td>

                            <td>
                                <span class="rol <?= htmlspecialchars($kullanici["rol"]) ?>">
                                    <?= $kullanici["rol"] === "admin" ? "Admin" : "Kullanıcı" ?>
                                </span>
                            </td>

                            <td>
                                <?= htmlspecialchars($kullanici["kayit_tarihi"] ?? "-", ENT_QUOTES, "UTF-8") ?>
                            </td>

                            <td>

                                <?php if ((int)$kullanici["id"] === (int)$_SESSION["kullanici_id"]): ?>

                                    <span class="kendi-hesabin">Senin hesabın</span>

                                <?php elseif ($kullanici["rol"] === "admin"): ?>

                                    <span class="kendi-hesabin">Korunan admin</span>

                                <?php else: ?>

                                    <form method="POST" class="sil-form">

                                        <input
                                            type="hidden"
                                            name="csrf_token"
                                            value="<?= htmlspecialchars($_SESSION["csrf_token"], ENT_QUOTES, "UTF-8") ?>"
                                        >

                                        <input
                                            type="hidden"
                                            name="kullanici_id"
                                            value="<?= (int)$kullanici["id"] ?>"
                                        >

                                        <button
                                            type="button"
                                            class="sil-buton"
                                            onclick="silmePenceresiAc(this)"
                                        >
                                            🗑️ Sil
                                        </button>

                                        <input type="hidden" name="kullanici_sil" value="1">

                                    </form>

                                <?php endif; ?>

