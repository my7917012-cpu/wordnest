
<?php
session_start();

require_once __DIR__ . "/../config/baglanti.php";

// Admin kontrolü
if (!isset($_SESSION["kullanici_id"]) || ($_SESSION["rol"] ?? "") !== "admin") {
    header("Location: ../kullanici/giris.php");
    exit;
}

// CSRF token oluştur
if (empty($_SESSION["csrf_token"])) {
    $_SESSION["csrf_token"] = bin2hex(random_bytes(32));
}

$mesaj = "";
$mesajTuru = "";

// Kullanıcı silme işlemi
if ($_SERVER["REQUEST_METHOD"] === "POST" && isset($_POST["kullanici_sil"])) {

    $token = $_POST["csrf_token"] ?? "";

    if (!hash_equals($_SESSION["csrf_token"], $token)) {
        $mesaj = "Güvenlik doğrulaması başarısız.";
        $mesajTuru = "hata";
    } else {

        $silinecekId = (int)($_POST["kullanici_id"] ?? 0);

        // Admin kendi hesabını silemez.
        if ($silinecekId === (int)$_SESSION["kullanici_id"]) {
            $mesaj = "Kendi admin hesabını silemezsin.";
            $mesajTuru = "hata";
        } else {

            // Yalnızca normal kullanıcıları sil.
            $sil = $db->prepare("
                DELETE FROM kullanicilar
                WHERE id = ? AND rol = 'user'
            ");

            $sil->execute([$silinecekId]);

            if ($sil->rowCount() > 0) {
                $mesaj = "Kullanıcı başarıyla silindi.";
                $mesajTuru = "basari";
            } else {
                $mesaj = "Kullanıcı bulunamadı veya silme işlemi yapılamadı.";
                $mesajTuru = "hata";
            }
        }
    }
}

// Kullanıcıları getir
$sorgu = $db->query("
    SELECT
        id,
        kullanici_adi,
        ad_soyad,
        email,
        rol,
        kayit_tarihi
    FROM kullanicilar
    ORDER BY kayit_tarihi DESC
");

$kullanicilar = $sorgu->fetchAll();

// Toplam kullanıcı sayısı
$toplamKullanici = count($kullanicilar);
?>

