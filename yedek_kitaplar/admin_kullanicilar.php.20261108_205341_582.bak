<!-- Silme Onay Penceresi -->

<div class="modal" id="silmeModal">
    <div class="modal-icerik">

        <div class="modal-ikon">⚠️</div>

        <h3>Kullanıcı Silinsin mi?</h3>

        <p>
            Bu kullanıcının hesabını silmek istediğine emin misin?
            Bu işlem geri alınamaz.
        </p>

        <div class="modal-butonlar">
            <button type="button" class="vazgec-buton" onclick="modalKapat()">
                Vazgeç
            </button>

            <button type="button" class="onayla-buton" onclick="silmeOnayla()">
                Evet, Sil
            </button>
        </div>

    </div>
</div>

<script>
let silinecekForm = null;

function silmePenceresiAc(buton) {
    silinecekForm = buton.closest("form");
    document.getElementById("silmeModal").classList.add("aktif");
}

function modalKapat() {
    document.getElementById("silmeModal").classList.remove("aktif");
    silinecekForm = null;
}

function silmeOnayla() {
    if (silinecekForm) {
        silinecekForm.submit();
    }
}

document.getElementById("silmeModal").addEventListener("click", function(e) {
    if (e.target === this) {
        modalKapat();
    }
});
</script>

<script src="../assets/js/gece-modu.js"></script>
<script src="../assets/js/dil-degistir.js"></script>
</body>
