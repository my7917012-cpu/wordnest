    <?php if ($mesaj !== ""): ?>
        <div class="message <?= htmlspecialchars($mesajTuru) ?>">
            <?= htmlspecialchars($mesaj, ENT_QUOTES, "UTF-8") ?>
        </div>
    <?php endif; ?>

    <div class="info-card">
        <span>Toplam Kayıtlı Hesap</span>
        <strong><?= $toplamKullanici ?></strong>
